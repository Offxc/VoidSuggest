# Copy to .env and fill in. Never commit .env.

# ── Required ──────────────────────────────────────────────────────────────

# Password for the bundled database (Docker Compose only).
POSTGRES_PASSWORD=

# At least 32 random characters. Generate with: openssl rand -base64 48
# Signs sign-in sessions and protects the stored webhook URL. Changing it signs
# everyone out and means the webhook has to be entered again.
SESSION_SECRET=

# The public address of the site, exactly as people type it. Must be https in
# production. The Discord redirect is derived from it: SITE_URL/api/auth/callback
SITE_URL=https://suggest.example.com

# From the Discord developer portal (see the README).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# The ID of your Discord server.
DISCORD_GUILD_ID=

# ── Optional ──────────────────────────────────────────────────────────────

# Only this Discord user can claim ownership by being first to sign in. Leave
# blank and the first person to sign in becomes the owner.
OWNER_DISCORD_ID=

# Which header carries the visitor's real address, set by your reverse proxy.
# Used for rate limiting and the audit log. For x-forwarded-for the last entry
# is trusted. Behind Cloudflare use cf-connecting-ip.
CLIENT_IP_HEADER=x-forwarded-for

# Shown on the privacy page as the place to ask about personal data.
CONTACT_EMAIL=

# How often (in minutes) names and roles are refreshed from Discord. 0 turns it off.
MEMBER_SYNC_MINUTES=15

# Host port the site listens on, on loopback only (Docker Compose).
WEB_PORT=3400

# ── Local development without Docker ──────────────────────────────────────
# `pnpm dev:db` starts a throwaway PostgreSQL and prints this URL.
# DATABASE_URL=postgresql://voidsuggest:voidsuggest_dev@127.0.0.1:55432/voidsuggest
